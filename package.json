{
  "name": "cgt-tracker",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "check:core": "npm run typecheck:core && npm test",
    "db:migrate": "node scripts/migrate.ts",
    "db:provision-logins": "node scripts/provision-runtime-logins.ts",
    "db:generate-auth": "tsx scripts/generate-auth-schema.ts",
    "db:expire-drafts": "node scripts/expire-import-drafts.ts",
    "test:postgres": "vitest run --config vitest.postgres.config.mts",
    "test:ui": "playwright test",
    "check:design": "node scripts/check-design.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "better-auth": "1.7.25",
    "decimal.js": "^10.6.0",
    "kysely": "0.29.9",
    "lucide-react": "^1.7.0",
    "next": "16.4.6",
    "papaparse": "^5.5.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.10.0",
    "stripe": "23.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.16",
    "@playwright/test": "1.65.1",
    "@types/node": "^24",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fast-check": "4.3.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.1.0"
  }
}
